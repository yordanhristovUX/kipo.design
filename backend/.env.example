# --- Server -----------------------------------------------------------------
PORT=3001
NODE_ENV=development

# Comma-separated allow-list of front-end origins (NO trailing slashes).
ALLOWED_ORIGINS=http://localhost:5173

# --- Admin auth -------------------------------------------------------------
# The single admin account. Generate the password hash with:
#   node scripts/hash-password.js "your-password"
ADMIN_EMAIL=admin@kipo.design
ADMIN_PASSWORD_HASH=

# Secret used to sign session JWTs. Use a long random string, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# --- Storage paths ----------------------------------------------------------
# Defaults resolve relative to backend/. In production point these at the
# persistent volume (e.g. /data/kipo.db and /data/uploads).
DB_PATH=./data/kipo.db
UPLOAD_DIR=./uploads
